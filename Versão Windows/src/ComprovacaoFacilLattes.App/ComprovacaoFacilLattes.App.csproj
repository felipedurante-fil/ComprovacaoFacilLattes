<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComprovacaoFacilLattes.Core\ComprovacaoFacilLattes.Core.csproj" />
    <ProjectReference Include="..\ComprovacaoFacilLattes.Infrastructure\ComprovacaoFacilLattes.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Dados de idioma do Tesseract — o app precisa deles na PRÓPRIA pasta de saída em
       tempo de execução (referenciar o projeto não copia os arquivos de dados dele). -->
  <ItemGroup>
    <None Include="..\ComprovacaoFacilLattes.Infrastructure\TessData\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TessData\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
