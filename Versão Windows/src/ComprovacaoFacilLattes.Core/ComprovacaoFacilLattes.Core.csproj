<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Tabelas Qualis (CAPES) por quadriênio — embutidas no assembly, reaproveitadas
       tal como já estavam empacotadas no app macOS (mesmo formato .tsv.gz). -->
  <ItemGroup>
    <EmbeddedResource Include="QualisData\*.tsv.gz" />
  </ItemGroup>

</Project>
